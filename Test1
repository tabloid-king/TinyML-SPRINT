<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>My First Website</title>
        <link rel="stylesheet" href="style.css" />
        <link rel="shortcut icon" href="images/Gemini_Generated_Image_i4g3wpi4g3wpi4g3.png" />
    </head>
    <body style="font-family: Arial, sans-serif; padding: 20px;">
       
        <button 
            onclick="toggleGreeting()" 
            style="font-size: 20px; background-color: #4a5568; color: #e2e8f0; padding: 10px 20px; border-radius: 12px; border: 2px dashed #90cdf4; cursor: pointer;">
            Click me
        </button>

        <p id="greeting" style="font-size: 24px; font-weight: bold; margin-top: 20px;">Hello</p>

        <script>
            function toggleGreeting() {
                const greetingElement = document.getElementById("greeting");
                if (greetingElement.innerHTML === "Hello") {
                    greetingElement.innerHTML = "Goodbye";
                } else {
                    greetingElement.innerHTML = "Hello";
                }
            }
        </script>
    </body>
</html>
